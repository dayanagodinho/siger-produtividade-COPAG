# ---------------------------------------------------------------------
# Conexao com o PostgreSQL
# No Railway, use a referencia ${{Postgres.DATABASE_URL}} em vez de colar
# o endereco: assim ele acompanha qualquer troca de senha do banco.
# ---------------------------------------------------------------------
DATABASE_URL=postgres://usuario:senha@localhost:5432/siger_produtividade

# TLS na conexao com o banco. Em branco, o sistema decide sozinho: rede
# interna e maquina local sem TLS, o resto com. Use true ou false so se
# precisar mandar na mao.
# DATABASE_SSL=

# Porta do servidor HTTP (o Railway define esta variavel sozinho)
PORT=3000

# Segredo usado para assinar o cookie de sessao (troque em producao)
SESSION_SECRET=troque-este-valor-em-producao

# Ambiente: development | production
NODE_ENV=development

# ---------------------------------------------------------------------
# Primeira subida
# Lidas apenas quando o banco ainda nao tem ninguem cadastrado. Criam o
# setor e o administrador que vai entrar pela primeira vez. Depois disso
# podem ser apagadas.
# ---------------------------------------------------------------------
ADMIN_NOME=
ADMIN_EMAIL=
ADMIN_SENHA=
ADMIN_MATRICULA=
SETOR_NOME=
SETOR_SIGLA=

# A lista de atividades da COPAG entra sozinha na primeira subida, junto
# com os grupos e os feriados do ano. Ponha false para comecar do zero e
# cadastrar tudo pela tela.
# IMPORTAR_CATALOGO=true

# Aplicar migracoes pendentes ao iniciar. Deixe ligado.
# MIGRAR_AO_INICIAR=true
