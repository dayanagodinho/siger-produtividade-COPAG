# Railway injeta DATABASE_URL automaticamente ao adicionar o plugin Postgres.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/escala
# Troque por uma frase longa e aleatória antes de subir em produção.
JWT_SECRET=troque-esta-chave-por-algo-longo-e-aleatorio
# Senha inicial dada a todos os servidores criados pelo seed.
SENHA_PADRAO=mudar123
PORT=3000
