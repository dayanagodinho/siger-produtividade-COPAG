# Railway injeta DATABASE_URL automaticamente (referencia ${{Postgres.DATABASE_URL}}).
DATABASE_URL=postgresql://usuario:senha@localhost:5432/escala
# Schema dentro do banco onde ficam as tabelas deste app (padrao: escala).
# As tabelas do SIGAP ficam no schema public, intactas.
# DB_SCHEMA=escala
# TLS com o banco. Em branco, decide sozinho (rede interna e local sem TLS; producao com).
# DATABASE_SSL=
# Segredo da sessao. JWT_SECRET ou SESSION_SECRET (o bloco herdado do SIGAP ja tem este).
JWT_SECRET=troque-esta-chave-por-algo-longo-e-aleatorio
# Senha inicial (provisoria) de quem o seed ou a chefia cria; o sistema exige trocar no primeiro acesso.
SENHA_PADRAO=12345678
PORT=3000
